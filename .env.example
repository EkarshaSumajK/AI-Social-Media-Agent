# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL_DASHBOARD=postgresql+asyncpg://user:password@host:5432/dashboard
REDIS_URL=redis://redis:6379/0

# ── Auth Secrets ──────────────────────────────────────────────────────
JWT_SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── LLM / AI ─────────────────────────────────────────────────────────
LLM_API_KEY=
FIRECRAWL_API_KEY=

# ── News & Search ────────────────────────────────────────────────────
NEWS_API_KEY=
NEWSAPI_KEY=
SERPAPI_KEY=

# ── X / Twitter ──────────────────────────────────────────────────────
X_BEARER_TOKEN=

# ── Notifications ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── OAuth 2.0 — Social Account Connect ──────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudinary ───────────────────────────────────────────────────────
